---
// Typographic wordmark. Placeholder until Mark supplies the logo from the work shirt (Briefing Q27).
interface Props {
  size?: "sm" | "lg";
}
const { size = "sm" } = Astro.props;
---

<span class:list={["wordmark", `wordmark--${size}`]} aria-label="M.E Projects">
  <span class="wordmark__me" aria-hidden="true">M<span class="wordmark__dot"></span>E</span>
  <span class="wordmark__projects" aria-hidden="true">Projects</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    color: var(--heading);
    font-stretch: 125%;
    line-height: 1;
    white-space: nowrap;
  }

  .wordmark__me {
    font-weight: 800;
    font-size: 1.35em;
    letter-spacing: 0.01em;
  }

  /* The full stop is a square block: a set-out peg, not a round dot. */
  .wordmark__dot {
    display: inline-block;
    width: 0.2em;
    height: 0.2em;
    margin-inline: 0.08em;
    background: currentColor;
  }

  .wordmark__projects {
    font-weight: 560;
    font-size: 0.8em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .wordmark--lg {
    font-size: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }
</style>
