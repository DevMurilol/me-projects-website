---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Button from "../components/Button.astro";
import { getContactForm, getServices, getSite, serviceAreaSentence } from "../lib/content";
import { ENQUIRY_ENDPOINT, MAX_TOTAL_BYTES, TURNSTILE_ACTION } from "../lib/enquiry-config";

const site = await getSite();
const form = await getContactForm();
const services = await getServices();
const optionsFor = (f: (typeof form.fields)[number]) =>
  f.optionsFrom === "services" ? services.map((s) => s.data.title) : (f.options ?? []);

// Public Turnstile site key. PUBLIC_TURNSTILE_SITE_KEY (.env, local only) can swap in Cloudflare's testing key.
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || form.turnstileSiteKey;
if (form.enabled && !siteKey) {
  throw new Error("contact-form.yaml: the form is enabled but turnstileSiteKey is empty. Add the site key or set enabled: false.");
}

// While the form is off, enquiries go by email, pre-filled with the same fields.
const emailFields = form.fields.filter((f) => !["name", "email", "message", "files"].includes(f.name));
const emailBody = [
  "Name:",
  ...emailFields.map((f) => `${f.label}:`),
  "",
  "About the project:",
  "",
  "",
  "(Photos or plans are welcome as attachments.)",
].join("\n");
const mailto = `mailto:${site.enquiryEmail}?subject=${encodeURIComponent("Project enquiry")}&body=${encodeURIComponent(emailBody)}`;
---

<Base
  title="Book a consultation"
  description={`Talk to M.E Projects about your extension, new build, deck, bathroom or fit-out. Call ${site.phone} or send an enquiry.`}
  board={false}
>
  <PageHead
    title="Book a consultation"
    lead="Tell us about your project and we'll get back to you to arrange a time on site."
  />

  <section class="container contact">
    {!form.enabled && (
      <div class="enquiry enquiry--email">
        <h2 class="enquiry__title">Send us your project details</h2>
        <p class="muted">
          The email below opens with everything we need already listed. Fill in what you know and attach any photos or
          plans.
        </p>
        <ul class="enquiry__list">
          {form.fields.filter((f) => f.name !== "message").map((f) => <li>{f.label}</li>)}
        </ul>
        <div class="enquiry__actions">
          <Button href={mailto}>Email your project details</Button>
          <a class="link" href={`tel:${site.phoneHref}`}>Or call {site.phone}</a>
        </div>
      </div>
    )}
    {form.enabled && (
    <div class="enquiry-wrap">
    <form
      class="enquiry"
      novalidate
      data-enquiry
      data-endpoint={ENQUIRY_ENDPOINT}
      data-sitekey={siteKey}
      data-action={TURNSTILE_ACTION}
      data-max-total={MAX_TOTAL_BYTES}
      data-phone={site.phone}
    >
      {
        form.fields.map((f) => (
          <div class:list={["field", (f.type === "textarea" || f.type === "file") && "field--wide"]}>
            <label for={`f-${f.name}`}>
              {f.label}
              {!f.required && <span class="optional"> (optional)</span>}
            </label>
            {f.type === "select" ? (
              <select class="select" id={`f-${f.name}`} name={f.name} required={f.required} aria-describedby={`e-${f.name}`}>
                <option value="">Choose one</option>
                {optionsFor(f).map((o) => (
                  <option value={o.replace(/\s*\[mock\]/i, "")}>{o.replace(/\s*\[mock\]/i, "")}</option>
                ))}
              </select>
            ) : f.type === "textarea" ? (
              <textarea class="textarea" id={`f-${f.name}`} name={f.name} rows="5" maxlength="5000" required={f.required} aria-describedby={`e-${f.name}`} />
            ) : f.type === "file" ? (
              <>
                <input
                  class="input input--file"
                  type="file"
                  id={`f-${f.name}`}
                  name={f.name}
                  accept={f.accept}
                  multiple
                  data-max={f.maxFiles}
                  aria-describedby={`h-${f.name} e-${f.name}`}
                />
                <span class="hint" id={`h-${f.name}`}>
                  Up to {f.maxFiles} photos or PDF plans, 20 MB in total. Large photos are resized before sending.
                </span>
              </>
            ) : (
              <input
                class="input"
                type={f.type}
                id={`f-${f.name}`}
                name={f.name}
                required={f.required}
                maxlength={f.type === "email" ? 254 : f.type === "tel" ? 30 : 120}
                autocomplete={f.type === "email" ? "email" : f.type === "tel" ? "tel" : f.name === "name" ? "name" : undefined}
                aria-describedby={`e-${f.name}`}
              />
            )}
            <span class="error" id={`e-${f.name}`} />
          </div>
        ))
      }
      <!-- Honeypot: hidden from people and screen readers. A value here means a bot. -->
      <div class="hp" aria-hidden="true">
        <label for="f-company">Company</label>
        <input id="f-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="field--wide turnstile" data-turnstile></div>
      <p class="form-note muted">
        Your details are only used to reply to your enquiry. See our <a class="link" href="/privacy-policy">privacy policy</a>.
      </p>
      <div class="field--wide form-actions">
        <Button type="submit">Send enquiry</Button>
        <p class="form-status" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
    <div class="enquiry enquiry--done" data-done hidden tabindex="-1" aria-labelledby="done-heading">
      <h2 class="enquiry__title" id="done-heading">Thanks<span data-done-name></span>. Your enquiry is on its way.</h2>
      <p>We'll be in touch to talk it through and arrange a time on site.</p>
      <p class="muted" data-done-copy hidden>We've emailed a copy to <strong data-done-email></strong>.</p>
      <p>If it's urgent, call <a class="link" href={`tel:${site.phoneHref}`}>{site.phone}</a>.</p>
    </div>
    </div>
    )}

    <aside class="direct">
      <h2 class="direct__title">Prefer to talk?</h2>
      <a class="direct__phone" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
      <dl class="direct__list">
        <div>
          <dt>Hours</dt>
          {site.hours.map((h) => <dd>{h.days ? `${h.days}, ${h.time}` : h.time}</dd>)}
        </div>
        <div>
          <dt>Where we work</dt>
          <dd>{serviceAreaSentence(site.serviceAreas)}</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{site.address.suburb} {site.address.state}</dd>
        </div>
      </dl>
    </aside>
  </section>
</Base>

<script>
  // Sends the enquiry to the Worker (worker/index.ts), which checks Turnstile and emails it through Resend.
  // The same checks run again on the server; these only save a round trip.
  interface Turnstile {
    render(el: HTMLElement, options: Record<string, unknown>): string;
    reset(widgetId: string): void;
    getResponse(widgetId: string): string | undefined;
  }
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  const form = document.querySelector<HTMLFormElement>("[data-enquiry]");
  const status = document.querySelector<HTMLElement>("[data-status]");
  const done = document.querySelector<HTMLElement>("[data-done]");
  const win = window as unknown as { turnstile?: Turnstile; onTurnstileLoad?: () => void };
  let widgetId: string | undefined;
  let sending = false;

  const errorFor = (el: Field) => document.getElementById(`e-${el.name}`);
  const fields = () => [...(form?.querySelectorAll<Field>("input, select, textarea") ?? [])].filter((el) => errorFor(el));

  const messageFor = (el: Field) => {
    if (el instanceof HTMLInputElement && el.type === "file") {
      const max = Number(el.dataset.max || 5);
      return el.files && el.files.length > max ? `Choose up to ${max} files.` : "";
    }
    if (el.validity.valueMissing) return "This field is required.";
    if (el.validity.typeMismatch && el.type === "email") return "Enter an email address like name@example.com.";
    if (el.type === "tel" && el.value.trim() && (/[^\d\s()+-]/.test(el.value) || el.value.replace(/\D/g, "").length < 8)) {
      return "Enter a phone number we can call.";
    }
    return "";
  };

  const showError = (el: Field, msg: string) => {
    const error = errorFor(el);
    if (error) error.textContent = msg;
    el.setAttribute("aria-invalid", msg ? "true" : "false");
  };

  // Phone photos are often 3-8 MB. Resizing to 2400px keeps them sharp and well under the email limit.
  async function shrink(file: File): Promise<File> {
    if (!/^image\/(jpeg|png|webp)$/.test(file.type) || file.size <= 1.5 * 1024 * 1024) return file;
    try {
      const bitmap = await createImageBitmap(file, { imageOrientation: "from-image" });
      const scale = Math.min(1, 2400 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(bitmap.width * scale);
      canvas.height = Math.round(bitmap.height * scale);
      const ctx = canvas.getContext("2d");
      if (!ctx) return file;
      ctx.fillStyle = "#fff"; // transparent PNGs become white, not black, as JPEG
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, "image/jpeg", 0.85));
      if (!blob || blob.size >= file.size) return file;
      return new File([blob], file.name.replace(/\.(jpe?g|png|webp)$/i, "") + ".jpg", { type: "image/jpeg" });
    } catch {
      return file; // the server accepts the original if it fits
    }
  }

  if (form) {
    // Explicit render, so the single-use token can be reset after each attempt.
    const box = form.querySelector<HTMLElement>("[data-turnstile]");
    win.onTurnstileLoad = () => {
      if (!box || !win.turnstile) return;
      widgetId = win.turnstile.render(box, {
        sitekey: form.dataset.sitekey,
        action: form.dataset.action,
        theme: "auto",
        size: "flexible",
      });
    };
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad";
    script.async = true;
    document.head.append(script);
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (sending || !status) return;

    let first: Field | null = null;
    for (const el of fields()) {
      const msg = messageFor(el);
      showError(el, msg);
      if (msg && !first) first = el;
    }
    if (first) {
      first.focus();
      status.textContent = "Check the highlighted fields.";
      return;
    }

    const token = widgetId !== undefined ? win.turnstile?.getResponse(widgetId) : undefined;
    if (!token) {
      status.textContent = "Please wait for the security check above to finish, then send again.";
      return;
    }

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const fallback = `Please call ${form.dataset.phone} or try again.`;
    sending = true;
    button?.setAttribute("disabled", "");
    form.setAttribute("aria-busy", "true");
    status.textContent = "Sending your enquiry...";

    let sent = false;
    let attempted = false;
    try {
      const data = new FormData(form);
      const fileInput = form.querySelector<HTMLInputElement>('input[type="file"]');
      if (fileInput?.files?.length) {
        status.textContent = "Preparing your photos...";
        const files = await Promise.all([...fileInput.files].map(shrink));
        if (files.reduce((sum, f) => sum + f.size, 0) > Number(form.dataset.maxTotal)) {
          showError(fileInput, "Files must be under 20 MB in total.");
          fileInput.focus();
          status.textContent = "Check the highlighted fields.";
          return;
        }
        data.delete(fileInput.name);
        files.forEach((f) => data.append(fileInput.name, f));
        status.textContent = "Sending your enquiry...";
      }

      attempted = true;
      const response = await fetch(form.dataset.endpoint!, { method: "POST", body: data });
      const result: { ok?: boolean; error?: string; fields?: Record<string, string>; confirmationSent?: boolean } =
        await response.json().catch(() => ({}));

      if (response.ok && result.ok) {
        sent = true;
        status.textContent = "";
        const name = String(data.get("name") ?? "").trim().split(/\s+/)[0];
        const email = String(data.get("email") ?? "").trim();
        done!.querySelector("[data-done-name]")!.textContent = name ? `, ${name}` : "";
        done!.querySelector("[data-done-email]")!.textContent = email;
        done!.querySelector<HTMLElement>("[data-done-copy]")!.hidden = !result.confirmationSent;
        form.hidden = true;
        done!.hidden = false;
        done!.focus();
        done!.scrollIntoView({ block: "start", behavior: "smooth" });
        return;
      }

      if (result.fields) {
        let firstBad: Field | null = null;
        for (const el of fields()) {
          const msg = result.fields[el.name] ?? "";
          showError(el, msg);
          if (msg && !firstBad) firstBad = el;
        }
        firstBad?.focus();
      }
      status.textContent = result.error ?? `Something went wrong. ${fallback}`;
    } catch {
      status.textContent = `We couldn't reach our server. Check your connection, or ${fallback.charAt(0).toLowerCase()}${fallback.slice(1)}`;
    } finally {
      sending = false;
      button?.removeAttribute("disabled");
      form.removeAttribute("aria-busy");
      // Tokens are single-use: get a fresh one before the next attempt.
      if (attempted && !sent && widgetId !== undefined) win.turnstile?.reset(widgetId);
    }
  });

  form?.addEventListener("input", (e) => {
    const el = e.target as Field;
    if (el.getAttribute("aria-invalid") === "true" && !messageFor(el)) showError(el, "");
  });
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
    padding-bottom: var(--section);
  }

  .enquiry {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--surface);
    border-radius: var(--radius);
  }

  /* display: grid above would otherwise override the hidden attribute (form after sending, thank-you before). */
  .enquiry[hidden] {
    display: none;
  }

  .enquiry[aria-busy="true"] {
    cursor: progress;
  }

  .enquiry--email,
  .enquiry--done {
    grid-template-columns: 1fr;
    gap: 1.25rem;
    align-content: start;
  }

  .enquiry--done:focus {
    outline: none;
  }

  .enquiry__title {
    font-size: var(--fs-lg);
  }

  .enquiry__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 1.5rem;
    color: var(--heading);
    font-weight: 560;
  }

  .enquiry__list li {
    padding-left: 1.1rem;
    position: relative;
  }

  .enquiry__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--heading);
  }

  .enquiry__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.5rem;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .input--file {
    padding: 0.6rem;
  }

  .input--file::file-selector-button {
    margin-right: 1rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--heading);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Reserve the widget's height so the button doesn't jump when it loads. */
  .turnstile {
    min-height: 65px;
  }

  .form-note {
    grid-column: 1 / -1;
    font-size: var(--fs-sm);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .form-actions :global(button[disabled]) {
    opacity: 0.6;
    cursor: progress;
  }

  .form-status {
    color: var(--heading);
    font-weight: 600;
  }

  .direct {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .direct__title {
    font-size: var(--fs-md);
  }

  .direct__phone {
    color: var(--heading);
    font-size: var(--fs-xl);
    font-stretch: 125%;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-decoration: none;
  }

  .direct__list {
    display: grid;
    gap: 1.25rem;
    margin: 1.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .direct__list dt {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .direct__list dd {
    margin: 0.2rem 0 0;
    color: var(--heading);
    font-weight: 600;
    font-stretch: 112%;
  }

  @media (max-width: 56rem) {
    .contact {
      grid-template-columns: 1fr;
    }

    .direct {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 36rem) {
    .enquiry {
      grid-template-columns: 1fr;
    }
  }
</style>
