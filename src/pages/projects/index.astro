---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getProjects, getServices } from "../../lib/content";

const projects = await getProjects();
const services = (await getServices()).filter((s) => projects.some((p) => p.data.service.id === s.id));
---

<Base title="Projects" description="Extensions, new builds, decks, bathrooms, renovations and fit-outs by M.E Projects.">
  <PageHead title="Projects" lead="A selection of recent work across the southern Gold Coast and Northern NSW.">
    <div class="filters" role="group" aria-label="Filter projects by service">
      <button type="button" class="chip" data-filter="all" aria-pressed="true">All</button>
      {
        services.map((s) => (
          <button type="button" class="chip" data-filter={s.id} aria-pressed="false">
            {s.data.title}
          </button>
        ))
      }
    </div>
  </PageHead>

  <section class="container" aria-label="Project list">
    <p class="visually-hidden" aria-live="polite" data-count></p>
    <div class="grid">
      {
        projects.map((p) => (
          <div class="grid__item" data-service={p.data.service.id}>
            <ProjectCard project={p} ratio="natural" headingLevel="h2" />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
  const items = document.querySelectorAll<HTMLElement>(".grid__item");
  const count = document.querySelector<HTMLElement>("[data-count]");

  chips.forEach((chip) =>
    chip.addEventListener("click", () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
      let shown = 0;
      items.forEach((item) => {
        const match = filter === "all" || item.dataset.service === filter;
        item.hidden = !match;
        if (match) shown++;
      });
      if (count) count.textContent = `Showing ${shown} project${shown === 1 ? "" : "s"}`;
    }),
  );
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .chip {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--heading);
    font: inherit;
    font-size: 0.95rem;
    font-stretch: 112%;
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .chip:hover {
    border-color: var(--heading);
  }

  .chip[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  /* Masonry by columns: photos keep their natural proportions. */
  .grid {
    columns: 3 18rem;
    column-gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: 2rem;
  }

  .grid__item {
    break-inside: avoid;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .grid__item[hidden] {
    display: none;
  }
</style>
