---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Stars from "../components/Stars.astro";
import heroPhoto from "../assets/photos/outdoor-kitchen-servery.webp";
import {
  getAbout,
  getProjects,
  getServices,
  getSite,
  getTestimonials,
  mock,
  plain,
  serviceAreaSentence,
} from "../lib/content";

const site = await getSite();
const about = await getAbout();
const services = await getServices();
const projects = await getProjects();
const testimonials = (await getTestimonials()).filter((t) => t.data.featured);

const qld = site.licences.find((l) => l.authority.startsWith("QBCC"));
const nsw = site.licences.find((l) => l.authority.startsWith("NSW"));

// Flagship: the best documented project (most photos). The others follow as cards.
const flagship = [...projects].sort((a, b) => b.data.gallery.length - a.data.gallery.length)[0];
const flagshipService = await getEntry(flagship.data.service);
const others = projects.filter((p) => p.id !== flagship.id).slice(0, 2);

// Spread photos: high-res landscapes (not the hero shot) plus one portrait.
const notHero = flagship.data.gallery.filter((g) => !g.image.src.includes("outdoor-kitchen-servery"));
const spreadWide = notHero.filter((g) => g.image.width >= 1400 && g.image.width > g.image.height).slice(0, 2);
const spreadTall = notHero.find((g) => g.image.height > g.image.width * 1.2);

// Services bento: the four priority services get photos, the other two are text tiles.
const [s1, s2, s3, s4, ...rest] = services;

const steps = [
  {
    title: "Consultation",
    text: "A paid consultation on site. We look at your block, plans and budget and give you straight advice.",
  },
  {
    title: "Design and planning",
    text: "We work through the plans, budget and timing with you before any work starts on site.",
  },
  {
    title: "Build",
    text: "You deal directly with the people on the tools, with regular updates from start to finish.",
  },
  {
    title: "Handover",
    text: `A final walkthrough together, with warranty ${site.warranty.charAt(0).toLowerCase()}${site.warranty.slice(1)}.`,
  },
];
---

<Base
  title={site.shortName}
  description={`Builders for extensions, new builds, decks and bathrooms across ${serviceAreaSentence(site.serviceAreas)}. Licensed in QLD and NSW.`}
>
  <!-- Hero: full-bleed photograph, copy from the original site set in the display serif -->
  <section class="hero">
    <div class="hero__media" data-hero-media>
      <Image
        src={heroPhoto}
        alt="Outdoor kitchen on a timber deck with a servery window opening into the kitchen"
        widths={[768, 1280, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy" data-hero>
        <h1 aria-label={site.intro.heading}>
          {
            site.intro.heading.split(" ").map((word, i) => (
              <>
                <span class="split-word" aria-hidden="true">
                  <span style={`--i: ${i}`}>{word}</span>
                </span>{" "}
              </>
            ))
          }
        </h1>
        <p class="hero__text">{site.intro.text}</p>
        <div class="hero__ctas">
          <Button href="/contact" variant="light">Book a consultation</Button>
          <Button href="/projects" variant="ghost-light">View projects</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Facts: plain credentials, no stat theatrics -->
  <section class="facts container" aria-label="Credentials">
    <dl>
      <div>
        <dt>{site.experience.split(",")[0]}</dt>
        <dd>Residential and commercial</dd>
      </div>
      {
        qld && (
          <div>
            <dt>QBCC {qld.number}</dt>
            <dd>Licensed in Queensland</dd>
          </div>
        )
      }
      {
        nsw && (
          <div>
            <dt>NSW {nsw.number}</dt>
            <dd>Licensed in New South Wales</dd>
          </div>
        )
      }
      <div>
        <dt>{site.insurance}</dt>
        <dd>Warranty {site.warranty.charAt(0).toLowerCase() + site.warranty.slice(1)}</dd>
      </div>
    </dl>
  </section>

  <!-- Services: asymmetric bento, exactly six cells -->
  <section class="section" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="services-heading">What we build</h2>
      </div>
      <div class="bento">
        {
          [s1, s2, s3, s4].map((s, i) => (
            <a
              href={`/services/${s.id}`}
              class:list={["bento__cell bento__cell--photo", `bento__cell--${i + 1}`]}
              data-reveal-item
              style={`--i: ${i % 2}`}
            >
              <div class="bento__img zoom settle">
                <Image
                  src={s.data.image}
                  alt=""
                  style={`view-transition-name: s-${s.id}; view-transition-class: photo`}
                  widths={[375, 750, 1200]}
                  sizes={i === 0 ? "(max-width: 48rem) 100vw, 58vw" : "(max-width: 48rem) 100vw, 33vw"}
                  class="cover"
                />
              </div>
              <div class="bento__text">
                <h3>{s.data.title}</h3>
                <p set:html={mock(s.data.summary)} />
              </div>
            </a>
          ))
        }
        {
          rest.map((s, i) => (
            <a
              href={`/services/${s.id}`}
              class:list={["bento__cell bento__cell--text", i === 1 && "bento__cell--navy"]}
              data-reveal-item
              style={`--i: ${i + 1}`}
            >
              <h3>{s.data.title}</h3>
              <p set:html={mock(s.data.summary)} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Flagship project: an editorial spread -->
  <section class="section section--tint" aria-labelledby="flagship-heading">
    <div class="container spread" data-reveal>
      <div class="spread__text">
        <h2 id="flagship-heading" set:html={mock(flagship.data.title)} />
        <p class="lead" set:html={mock(flagship.data.summary)} />
        <dl class="meta">
          {flagship.data.location && <div><dt>Location</dt><dd>{flagship.data.location}</dd></div>}
          <div><dt>Service</dt><dd>{flagshipService?.data.title}</dd></div>
          <div><dt>Photos</dt><dd>{flagship.data.gallery.length}</dd></div>
        </dl>
        <a class="link" href={`/projects/${flagship.id}`}>Read the project</a>
        {
          spreadTall && (
            <figure class="spread__tall">
              <div class="settle">
                <Image src={spreadTall.image} alt={spreadTall.caption ?? ""} widths={[375, 750]} sizes="(max-width: 48rem) 100vw, 26vw" />
              </div>
              {spreadTall.caption && <figcaption>{spreadTall.caption}</figcaption>}
            </figure>
          )
        }
      </div>
      <div class="spread__wide">
        {
          spreadWide.map((g) => (
            <figure>
              <div class="settle">
                <Image
                  src={g.image}
                  alt={g.caption ?? ""}
                  widths={[750, 1200, 1500]}
                  sizes="(max-width: 48rem) 100vw, 55vw"
                  style={g.image.src === flagship.data.coverImage.src ? `view-transition-name: p-${flagship.id}; view-transition-class: photo` : undefined}
                />
              </div>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- More projects: two covers, second one dropped for rhythm -->
  <section class="section" aria-labelledby="more-heading">
    <div class="container">
      <div class="more__head" data-reveal>
        <h2 id="more-heading">More projects</h2>
        <Button href="/projects" variant="ghost">View projects</Button>
      </div>
      <div class="more">
        {others.map((p, i) => <ProjectCard project={p} ratio="3x4" reveal={i} />)}
      </div>
    </div>
  </section>

  <!-- Approach: the promise as the headline, Mark's own words beneath -->
  <section class="section section--tint" aria-labelledby="approach-heading">
    <div class="container approach" data-reveal>
      <h2 id="approach-heading">Built by the people you talk to.</h2>
      <p class="approach__statement">{about.approach}</p>
      <ul class="approach__team">
        {
          about.team.map((m) => (
            <li>
              <span class="approach__name">{m.name}</span>
              <span class="muted">{m.role}</span>
            </li>
          ))
        }
      </ul>
      <a class="link" href="/about">About M.E Projects</a>
    </div>
  </section>

  <!-- Process: a real sequence, so numbers are earned -->
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 id="process-heading">How a project runs</h2>
      </div>
      <ol class="steps" data-reveal>
        {
          steps.map((step, i) => (
            <li>
              <span class="steps__num" aria-hidden="true">{i + 1}</span>
              <h3>{step.title}</h3>
              <p set:html={mock(step.text)} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Reviews: horizontal scroll-snap row -->
  <section class="section section--tint" aria-labelledby="reviews-heading">
    <div class="container">
      <div class="more__head" data-reveal>
        <h2 id="reviews-heading">What clients say</h2>
        <a class="link" href="/about#reviews">Read the full reviews</a>
      </div>
    </div>
    <ul class="reviews" data-reveal>
      {
        testimonials.map((t) => (
          <li class="review">
            <Stars rating={t.data.rating} />
            <blockquote>
              <p>&ldquo;{t.data.excerpt}&rdquo;</p>
            </blockquote>
            <p class="review__who">
              <span>{t.data.name}</span>
              <span class="muted">Google review</span>
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* ---------- Hero: full bleed, slides up under the floating header */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: min(100svh, 62rem);
    margin-top: calc(-1 * (var(--header-h) + 0.75rem));
    overflow: hidden;
    background: var(--navy-950);
    color: #f6f6f3;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 45%;
  }

  /* Navy scrim: strong behind the copy, clear over the servery and the bamboo. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgb(11 22 38 / 0.88) 0%, rgb(11 22 38 / 0.64) 38%, rgb(11 22 38 / 0.08) 74%),
      linear-gradient(0deg, rgb(11 22 38 / 0.62) 0%, transparent 55%);
  }

  .hero__content {
    padding-block: calc(var(--header-h) + 6rem) clamp(3rem, 7vw, 5.5rem);
  }

  .hero__copy {
    display: grid;
    gap: 1.5rem;
    max-width: 60rem;
  }

  /* Two lines at desktop: "Over 20 years' experience in both / residential and commercial projects." */
  .hero h1 {
    color: #f6f6f3;
    font-size: clamp(2.375rem, 1.35rem + 2.75vw, 3.9rem);
    line-height: 1.06;
  }

  .hero__text {
    max-width: 50ch;
    color: #d8dfe7;
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* ---------- Facts */
  .facts dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem 2rem;
    margin: 0;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    color: var(--heading);
    font-stretch: 125%;
    font-weight: 650;
    font-size: var(--fs-md);
    line-height: 1.2;
  }

  .facts dd {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  /* ---------- Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .bento__cell {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: var(--radius);
  }

  .bento__cell--1 {
    grid-column: span 7;
    grid-row: span 2;
  }

  .bento__cell--2,
  .bento__cell--3 {
    grid-column: span 5;
  }

  .bento__cell--4 {
    grid-column: 1 / span 4;
  }

  .bento__cell--text {
    grid-column: span 4;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    background: var(--surface);
    min-height: 13rem;
    transition: background-color var(--dur) var(--ease);
  }

  .bento__cell--text:hover {
    background: var(--concrete-deep);
  }

  .bento .bento__cell--navy {
    background: var(--board-bg);
  }

  .bento .bento__cell--navy:hover {
    background: var(--navy-800);
  }

  .bento .bento__cell--navy h3 {
    color: var(--board-text);
  }

  .bento .bento__cell--navy p {
    color: var(--board-muted);
  }

  .bento__img {
    flex: 1;
    min-height: 12rem;
    aspect-ratio: 4 / 3;
  }

  .bento__cell--1 .bento__img {
    aspect-ratio: auto;
    min-height: 22rem;
  }

  .bento__text {
    display: grid;
    gap: 0.4rem;
    padding-top: 1rem;
  }

  .bento h3 {
    font-size: var(--fs-md);
    line-height: 1.2;
  }

  .bento__cell--1 h3 {
    font-size: var(--fs-lg);
  }

  .bento p {
    color: var(--text-muted);
    font-size: 0.95rem;
    max-width: 44ch;
  }

  .bento__cell:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  /* ---------- Flagship spread */
  .spread {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .spread__text {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .spread__text .lead {
    max-width: 34ch;
  }

  .spread figure {
    margin: 0;
  }

  .spread figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .spread .spread__tall {
    width: min(100%, 22rem);
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .spread__wide {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .spread__wide figure:nth-child(2) {
    width: 82%;
    justify-self: end;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0.5rem 0;
  }

  .meta dt {
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .meta dd {
    margin: 0.2rem 0 0;
    font-weight: 600;
    font-stretch: 112%;
    color: var(--heading);
  }

  /* ---------- More projects */
  .more__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    max-width: 64rem;
  }

  .more > :global(:nth-child(2)) {
    margin-top: clamp(0rem, 8vw, 7rem);
  }

  /* ---------- Approach */
  .approach {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }

  .approach h2 {
    font-size: var(--fs-2xl);
    max-width: 14ch;
  }

  .approach__statement {
    max-width: 52ch;
    color: var(--heading);
    font-size: var(--fs-md);
    line-height: 1.55;
  }

  .approach__team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 4rem;
  }

  .approach__team li {
    display: grid;
    gap: 0.15rem;
  }

  .approach__name {
    font-weight: 650;
    font-stretch: 125%;
    color: var(--heading);
  }

  /* ---------- Steps */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .steps li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 2px solid var(--heading);
  }

  .steps__num {
    font-family: var(--serif);
    font-variation-settings: "opsz" 72;
    font-size: var(--fs-xl);
    font-weight: 400;
    line-height: 1;
    color: var(--heading);
  }

  .steps h3 {
    font-size: var(--fs-md);
  }

  .steps p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* ---------- Reviews */
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0.5rem max(var(--gutter), calc((100% - var(--max)) / 2)) 1rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80vw, 24rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), calc((100% - var(--max)) / 2));
    scrollbar-width: thin;
  }

  .review {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    scroll-snap-align: start;
  }

  .review blockquote {
    margin: 0;
    color: var(--heading);
    font-family: var(--serif);
    font-variation-settings: "opsz" 24;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .review__who {
    display: grid;
    gap: 0.1rem;
    font-weight: 600;
    font-stretch: 112%;
    font-size: 0.95rem;
  }

  .review__who .muted {
    font-weight: 400;
    font-stretch: 100%;
  }

  /* ---------- Mobile collapse */
  @media (max-width: 60rem) {
    .facts dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento__cell--1,
    .bento__cell--2,
    .bento__cell--3,
    .bento__cell--4,
    .bento__cell--text {
      grid-column: span 6;
      grid-row: auto;
    }

    .bento__cell--1 {
      grid-column: 1 / -1;
    }

    .bento__cell--1 .bento__img {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }

    .spread {
      grid-template-columns: 1fr;
    }

    .spread__tall {
      display: none;
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }

  @media (max-width: 48rem) {
    /* On phones the copy sits over the lower photo, so the scrim darkens from the bottom. */
    .hero__scrim {
      background: linear-gradient(0deg, rgb(11 22 38 / 0.92) 0%, rgb(11 22 38 / 0.7) 55%, rgb(11 22 38 / 0.3) 100%);
    }

    .bento__cell--1,
    .bento__cell--2,
    .bento__cell--3,
    .bento__cell--4,
    .bento__cell--text {
      grid-column: 1 / -1;
    }

    .spread__wide figure:nth-child(2) {
      width: 100%;
    }

    .more {
      grid-template-columns: 1fr;
    }

    .more > :global(:nth-child(2)) {
      margin-top: 0;
    }

    .steps {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .facts dl {
      grid-template-columns: 1fr;
    }
  }
</style>
